std::string Role::getDebugInfo() const
{
    std::ostringstream oss;

    oss << "[Role]"
        << " id=" << getObjectId()
        << " name=" << getObjectName()
        << " hp=" << hp << "/" << maxHp
        << " speed=" << speed
        << " armor=" << armor
        << " defense=" << defense
        << " baseDamage=" << baseDamage
        << " melee=" << meleeDamage
        << " ranged=" << rangedDamage
        << " elemental=" << elementalDamage
        << " alive=" << (isAlive ? "true" : "false");

    return oss.str();
}
